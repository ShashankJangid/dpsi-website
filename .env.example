# ============================================================
# DPSI Multi-Tenant School SaaS — Environment Variables
# ============================================================
# NEVER commit this file with real values to Git.
# Use Doppler (doppler.com) to manage secrets securely.
# Student Pack gives FREE Doppler Team plan.
#
# HOW TO USE WITH DOPPLER:
#   1. Install Doppler CLI: brew install dopplerhq/cli/doppler
#   2. Login: doppler login
#   3. Setup:  doppler setup  (select your project)
#   4. Run:    doppler run -- npm run dev
#   5. That's it — no .env file needed locally.
#
# HOW TO USE WITHOUT DOPPLER (local dev only):
#   Copy this file to .env and fill in your values.
# ============================================================

# --- DATABASE ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- AUTH ---
JWT_SECRET=<generate-with: openssl rand -hex 32>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>

# --- AI SERVICES ---
GROQ_API_KEY=gsk_<your-groq-key>
ELEVENLABS_API_KEY=sk_<your-elevenlabs-key>

# --- MEDIA STORAGE (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# --- ERROR MONITORING (Sentry - GitHub Student Pack FREE) ---
SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project-id>
VITE_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project-id>

# --- FEATURE FLAGS (ConfigCat - GitHub Student Pack FREE) ---
VITE_CONFIGCAT_SDK_KEY=<your-configcat-sdk-key>

# --- APP CONFIG ---
NODE_ENV=production
PORT=3000
VITE_APP_URL=https://dpsindirapuram.com
